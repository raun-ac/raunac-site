---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0,SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
  <div class="font-serif">
    <h2 class="animate font-semibold text-4xl text-black dark:text-white mb-8">
      Raunak Kumar
    </h2>
    <div class="space-y-16">
      <section>
        <article class="space-y-8 text-sm md:text-base">
          
          <div class="animate">
            <h3 class="font-semibold text-black dark:text-white mb-3">
              Some things about me:
            </h3>
            <ul class="list-disc ml-5 space-y-3 opacity-90">
              <li>
                <span class="font-medium text-black dark:text-white">I am a computer science undergrad currently in my sophomore year</span>.
              </li>
              <li>
                Before this, I've spent a significant amount of time training in competitive programming alongside my team, TuringMachine. My long-term goal is to achieve Red Coder status.
              </li>
              <li>
                I approach learning from first principles. Whether it's data structures or operating systems, I prefer deconstructing complex topics to ensure an intuitive understanding before mapping them to known patterns.
              </li>
              <li>
                I am deeply interested in cognitive science, specifically baseline dopamine management and optimizing constructive internal dialogue.
              </li>
            </ul>
          </div>

          <div class="animate">
            <h3 class="font-semibold text-black dark:text-white mb-3">
              Some things I'm interested in:
            </h3>
            <ul class="list-disc ml-5 space-y-3 opacity-90">
              <li>
                <span class="font-medium text-black dark:text-white">Competitive Programming:</span> I actively participate on Codeforces, AtCoder, and LeetCode, primarily writing solutions in C++.
              </li>
              <li>
                <span class="font-medium text-black dark:text-white">AI Infrastructure & Systems Engineering:</span> I enjoy exploring high-performance computing, memory management, and building custom vector databases using SIMD.
              </li>
              <li>
                <span class="font-medium text-black dark:text-white">Science Fiction:</span> I love high-stakes sci-fi literature and cinema, especially Frank Herbert's <em>Dune</em> series and Andy Weir's <em>Project Hail Mary</em>.
              </li>
            </ul>
          </div>

        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Latest posts
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Work Experience
          </h5>
          <Link href="/work">
            See all work
          </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {work.map(entry => (
            <li>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm opacity-75">
                {entry.data.role}
              </div>
              <article>
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Recent projects
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        <article>
          <p>
            If you want to get in touch with me about something or just to say hi,
            reach out on social media or send me an email.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
